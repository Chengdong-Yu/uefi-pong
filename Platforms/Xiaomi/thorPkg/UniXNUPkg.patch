+//
+// THOR: walk \\EFI -> \\EFI\\UniXNU -> the config file and record the first
+// component that is missing, plus a few root directory names, so the menu's
+// error line shows WHY the config was not found on a mounted volume.
+//
+STATIC
+VOID
+ThorDiagnoseConfigPath (
+  IN UNIXNU_CONFIG  *Config,
+  IN EFI_HANDLE     Volume
+  )
+{
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs;
+  EFI_FILE_PROTOCOL                *Root;
+  EFI_FILE_PROTOCOL                *Dir;
+  EFI_STATUS                       Status;
+
+  //
+  // Open the volume with our own handles: Volume.c's helpers are file-local.
+  //
+  Fs = NULL;
+  Root = NULL;
+  if (EFI_ERROR (gBS->HandleProtocol (Volume, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs)) ||
+      (Fs == NULL) || EFI_ERROR (Fs->OpenVolume (Fs, &Root)))
+  {
+    ConfigError (Config, "volume open failed");
+    return;
+  }
+
+  Status = Root->Open (Root, &Dir, L"\\EFI", EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (Status)) {
+    ConfigError (Config, "no \\EFI on volume (%r)", Status);
+    Root->Close (Root);
+    return;
+  }
+
+  Status = Dir->Open (Dir, &Root, L"UniXNU", EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (Status)) {
+    Dir->Close (Dir);
+    Root->Close (Root);
+    ConfigError (Config, "\\EFI ok, UniXNU dir %r", Status);
+    return;
+  }
+
+  Root->Close (Root);
+  Dir->Close (Dir);
+  ConfigError (Config, "\\EFI\\UniXNU ok, unixnu.toml %r", Status);
+}
+
