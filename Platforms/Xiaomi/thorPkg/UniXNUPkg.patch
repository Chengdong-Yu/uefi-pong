+//
+// Locate our FAT16 payload inside a bootloader-declared range: the ABL
+// initrd span also carries its own generic ramdisk content, so /chosen
+// start is NOT the FAT boot sector. 1029's payload verify (KMP search for
+// the THOR-PAYLOAD04 magic) proved on this device that the payload sits at
+// an arbitrary BYTE offset inside the span — so scan at 4-byte steps, not
+// sector steps. A hit does not need any alignment: BlockIo reads are
+// plain memory copies from the found address.
+//
+STATIC
+UINT64
+ScanRangeForFat (
+  IN  UINT64  Start,
+  IN  UINT64  End,
+  OUT UINT64  *Size
+  )
+{
+  UINT8   *Block;
+  UINT16  BytesPerSector;
+  UINT32  TotalSectors;
+
+  *Size = 0;
+
+  for (UINT64 Addr = Start; Addr + 512 <= End; Addr += 1) {
+    Block = (UINT8 *)(UINTN)Addr;
+    if ((Block[510] != 0x55) || (Block[511] != 0xAA)) {
+      continue;
+    }
+
+    if (CompareMem (Block + 0x2B, "UNIXNU", 6) != 0) {
+      continue;
+    }
+
+    BytesPerSector = (UINT16)(Block[0x0B] | (Block[0x0C] << 8));
+    TotalSectors   = (UINT16)(Block[0x13] | (Block[0x14] << 8));
+    if (TotalSectors == 0) {
+      TotalSectors = (UINT32)(Block[0x20] | (Block[0x21] << 8) |
+                              (Block[0x22] << 16) | (Block[0x23] << 24));
+    }
+
+    if ((BytesPerSector != RAM_BLOCK_SIZE) || (TotalSectors == 0) || (TotalSectors > 0x100000)) {
+      continue;
+    }
+
+    *Size = (UINT64)TotalSectors * RAM_BLOCK_SIZE;
+    return Addr;
+  }
+
+  return 0;
+}
+
+//
+// Look for our FAT16 payload by boot-sector signature inside the RAM the
+// firmware's own memory map describes: 0x55AA at 510 and the UNIXNU volume
+// label. The BPB supplies the true length, so the payload size may change
+// without touching this driver.
+//
+STATIC
+BOOLEAN
+ScanFatPayload (
+  VOID
+  )
+{
+  UINTN                  MapSize;
+  UINTN                  MapKey;
+  UINTN                  DescriptorSize;
+  UINT32                 DescriptorVersion;
+  EFI_MEMORY_DESCRIPTOR  *Map;
+  EFI_STATUS             Status;
+  UINT8                  *Block;
+  UINT16                 BytesPerSector;
+  UINT32                 TotalSectors;
+  UINT64                 Size;
+  UINT64                 Start;
+  UINT64                 End;
+
+  RdSay (L"UNIXNURAMDISK: memory-map scan for FAT payload...\r\n");
+
+  MapSize = 0;
+  Map     = NULL;
+  Status  = gBS->GetMemoryMap (&MapSize, Map, &MapKey, &DescriptorSize, &DescriptorVersion);
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    RdSay (L"UNIXNURAMDISK: GetMemoryMap failed\r\n");
+    return FALSE;
+  }
+
+  Map = AllocatePool (MapSize + 2 * DescriptorSize);
+  if (Map == NULL) {
+    return FALSE;
+  }
+
+  Status = gBS->GetMemoryMap (&MapSize, Map, &MapKey, &DescriptorSize, &DescriptorVersion);
+  if (EFI_ERROR (Status)) {
+    FreePool (Map);
+    RdSay (L"UNIXNURAMDISK: GetMemoryMap retry failed\r\n");
+    return FALSE;
+  }
+
+  for (UINTN Off = 0; Off < MapSize; Off += DescriptorSize) {
+    EFI_MEMORY_DESCRIPTOR  *D = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Off);
+
+    if (!IsRamType (D->Type)) {
+      continue;
+    }
+
+    Start = D->PhysicalStart;
+    End   = Start + (UINT64)D->NumberOfPages * EFI_PAGE_SIZE;
+    if (End <= THOR_SCAN_BASE) {
+      continue;
+    }
+
+    if (Start < THOR_SCAN_BASE) {
+      Start = THOR_SCAN_BASE;
+    }
+
+    if (End > THOR_SCAN_END) {
+      End = THOR_SCAN_END;
+    }
+
+    //
+    // Only whole 512-byte blocks inside this RAM descriptor are examined.
+    //
+    Start = (Start + RAM_BLOCK_SIZE - 1) & ~((UINT64)RAM_BLOCK_SIZE - 1);
+    for (UINT64 Addr = Start; Addr + 512 <= End; Addr += RAM_BLOCK_SIZE) {
+      Block = (UINT8 *)(UINTN)Addr;
+      if ((Block[510] != 0x55) || (Block[511] != 0xAA)) {
+        continue;
+      }
+
+      //
+      // macOS newfs_msdos writes "BSD  4.4" as the OEM name (not "MSDOS5.0"),
+      // so the volume label is the reliable marker of our payload.
+      //
+      if (CompareMem (Block + 0x2B, "UNIXNU", 6) != 0) {
+        continue;
+      }
+
+      BytesPerSector = (UINT16)(Block[0x0B] | (Block[0x0C] << 8));
+      TotalSectors   = (UINT16)(Block[0x13] | (Block[0x14] << 8));
+      if (TotalSectors == 0) {
+        TotalSectors = (UINT32)(Block[0x20] | (Block[0x21] << 8) |
+                                (Block[0x22] << 16) | (Block[0x23] << 24));
+      }
+
+      if ((BytesPerSector != RAM_BLOCK_SIZE) || (TotalSectors == 0) || (TotalSectors > 0x100000)) {
+        Print (L"UNIXNURAMDISK: FAT signature at 0x%lx but bad geometry (%u x %u)\r\n",
+          Addr, BytesPerSector, TotalSectors);
+        continue;
+      }
+
+      Size = (UINT64)TotalSectors * RAM_BLOCK_SIZE;
+      Print (L"UNIXNURAMDISK: FAT payload found at 0x%lx in %a memory\r\n",
+        Addr, (D->Type == EfiConventionalMemory) ? "free" : "firmware");
+      FreePool (Map);
+      return !EFI_ERROR (PublishRange (Addr, Addr + Size));
+    }
+  }
+
+  FreePool (Map);
+  RdSay (L"UNIXNURAMDISK: FAT payload not found in any RAM window\r\n");
+  return FALSE;
 }

